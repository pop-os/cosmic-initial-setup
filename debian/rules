#!/usr/bin/make -f

export DESTDIR = debian/tmp

%:
	dh $@

override_dh_auto_clean:
	ischroot || (just clean-dist && just vendor)

override_dh_auto_build:
	test -e vendor.tar && just disable-if-exists="/cdrom/casper/filesystem.squashfs" build-vendored --features pop-os \
	    || just disable-if-exists="/cdrom/casper/filesystem.squashfs" build-release --features pop-os

override_dh_auto_install:
	just rootdir=$(DESTDIR) install
